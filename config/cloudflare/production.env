# Build-time values for the production Worker (openthrone.dev).
# NEXT_PUBLIC_* values are inlined into the browser bundle, so this file holds
# public values only — never secrets. They mirror the production host's build
# flags as of v0.12.0 (2026-11-08), with the Workers realtime transport.
# Used by `bun run cloudflare:build:production` (scripts/cloudflare-build-profile.ts).
NEXTAUTH_URL=https://openthrone.dev
NEXT_PUBLIC_URL_ROOT=https://openthrone.dev
NEXT_PUBLIC_TURNSTILE_SITE_ID=0x4AAAAAAAJJlPwUwDISclq0
NEXT_PUBLIC_USE_CAPTCHA=true
NEXT_PUBLIC_DISABLE_TURNSTILE=false
NEXT_PUBLIC_USE_AWS=true
NEXT_PUBLIC_AWS_S3_ENDPOINT=https://assets.openthrone.dev
NEXT_PUBLIC_ASSETS_HOSTNAME=assets.openthrone.dev
NEXT_PUBLIC_ARTWORK_MODE=remote
NEXT_PUBLIC_ARTWORK_BASE_URL=https://assets.openthrone.dev
NEXT_PUBLIC_ENABLE_ATTACKING=false
NEXT_PUBLIC_ENABLE_ASSASSINATIONS=false
NEXT_PUBLIC_ENABLE_INFILTRATIONS=false
NEXT_PUBLIC_ENABLE_INTEL=false
NEXT_PUBLIC_ATTACK_LEVEL_RANGE=10
NEXT_PUBLIC_DISABLE_REGISTRATION=true
NEXT_PUBLIC_DISABLE_LOGIN=false
NEXT_PUBLIC_LOG_LEVEL=DEBUG
NEXT_PUBLIC_SHOW_AI_IMAGES=true
NEXT_PUBLIC_DISABLE_SOCKET=true
NEXT_PUBLIC_REALTIME_TRANSPORT=do
