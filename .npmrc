# npm uses strict peer-dep resolution by default, which fails on Cloudflare
# Pages because framer-motion@10 declares peerOptional react@^18 while the
# project runs React 19. Bun (local dev) is lenient about this, but the
# Cloudflare build auto-detects npm from package-lock.json and runs
# `npm clean-install`, so we relax peer-deps to match the documented local
# workflow (see README "Getting it running").
legacy-peer-deps=true
