{
  "name": "openthrone",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "build": "next build",
    "start": "next start -p 3001",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "export": "next export",
    "build-prod": "run-s clean build export",
    "clean": "rimraf .next .swc out coverage",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty && tsc --project cypress --noEmit --pretty",
    "test": "jest",
    "commit": "cz",
    "prepare": "husky install",
    "postinstall": "prisma generate",
    "postbuild": "next-sitemap",
    "bun-dev": "npx next",
    "migrate-user-json": "bunx ts-node scripts/migrate-user-json.ts",
    "cypress:install": "CYPRESS_CACHE_FOLDER=.cypress-cache bunx cypress install",
    "cypress:run": "CYPRESS_CACHE_FOLDER=.cypress-cache CYPRESS_APP_URL=https://alpha.openthrone.dev bunx cypress run --headless",
    "cypress:open": "CYPRESS_CACHE_FOLDER=.cypress-cache bunx cypress open",
    "cypress:open-xvfb": "CYPRESS_CACHE_FOLDER=.cypress-cache xvfb-run -s \"-screen 0 1920x1080x24\" bunx cypress open",
    "cypress:run-xvfb": "CYPRESS_CACHE_FOLDER=.cypress-cache CYPRESS_APP_URL=https://alpha.openthrone.dev xvfb-run -s \"-screen 0 1920x1080x24\" bunx cypress run --headless",
    "map:unused": "knip",
    "map:deps": "dependency-cruiser src --output-type json > .ai/dependency-map.json",
    "map:graph": "madge src --extensions ts,tsx --json > .ai/madge-map.json",
    "map:circular": "madge src --extensions ts,tsx --circular --exclude 'prisma/generated'",
    "ai:check": "bun run check-types && bun run lint && bun run map:unused && bun run map:circular",
    "docs:api": "typedoc",
    "docs:api:json": "typedoc --json docs/api.json --emit none",
    "docs:commit": "bun run docs:api && bun run docs:api:json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@hookform/resolvers": "^3.10.0",
    "@mantine/core": "^7.17.8",
    "@mantine/form": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@mantine/tiptap": "^7.17.8",
    "@marsidev/react-turnstile": "^0.7.2",
    "@opendominion/rpg-awesome": "^0.0.20",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "2.26.3",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "^1.3.8",
    "@types/md5": "^2.3.6",
    "@types/nodemailer": "^6.4.22",
    "argon2": "^0.44.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.1-rc-af1b7da-20250421",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "cookie": "^0.7.2",
    "cypress": "^13.17.0",
    "express-rate-limit": "^8.2.1",
    "formidable": "^3.5.4",
    "framer-motion": "^11.18.0",
    "i18next": "^25.8.4",
    "i18next-http-backend": "^3.0.2",
    "image-size": "^1.2.1",
    "lz-string": "^1.5.0",
    "md5": "^2.3.0",
    "mime-types": "^2.1.35",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-i18next": "^15.4.3",
    "next-mdx-remote": "^4.4.1",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.18.0",
    "prisma": "7",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^9.1.0",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swr": "^2.4.0",
    "tailwindcss": "^3.4.19",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "latest",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "autoprefixer": "^10.4.24",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cssnano": "^8.0.2",
    "cypress-visual-regression": "^5.3.0",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "fast-glob": "^3.3.3",
    "glob": "^7.2.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.16.0",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.10",
    "semantic-release": "^24.2.9",
    "ts-morph": "^27.0.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "@typescript-eslint/parser": "8.50.1",
    "@typescript-eslint/eslint-plugin": "8.50.1"
  },
  "overrides": {
    "@typescript-eslint/parser": "$@typescript-eslint/parser",
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "node-sass": "npm:sass@^1.101.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "author": "DasTacoMann (https://github.com/uaktags)"
}
