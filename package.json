{
  "name": "openthrone",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run src/server/index.ts",
    "build": "next build",
    "start": "next start -p 3001",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "export": "next export",
    "build-prod": "run-s clean build export",
    "clean": "rimraf .next .swc out coverage",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty && tsc --project cypress --noEmit --pretty",
    "test": "jest",
    "commit": "cz",
    "prepare": "husky install",
    "postbuild": "next-sitemap",
    "bun-dev": "npx next",
    "migrate-user-json": "bunx ts-node scripts/migrate-user-json.ts",
    "cypress:install": "CYPRESS_CACHE_FOLDER=.cypress-cache bunx cypress install",
    "cypress:run": "CYPRESS_CACHE_FOLDER=.cypress-cache CYPRESS_APP_URL=https://alpha.openthrone.dev bunx cypress run --headless",
    "cypress:open": "CYPRESS_CACHE_FOLDER=.cypress-cache bunx cypress open",
    "cypress:open-xvfb": "CYPRESS_CACHE_FOLDER=.cypress-cache xvfb-run -s \"-screen 0 1920x1080x24\" bunx cypress open",
    "cypress:run-xvfb": "CYPRESS_CACHE_FOLDER=.cypress-cache CYPRESS_APP_URL=https://alpha.openthrone.dev xvfb-run -s \"-screen 0 1920x1080x24\" bunx cypress run --headless"
  },
