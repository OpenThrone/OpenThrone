enum AllianceListType {
  FARM
  HIT
  BLOCK
}

enum AllianceRelationStatus {
  PENDING
  ACTIVE
}

/// Shared Farm / Hit / Block target lists kept by an alliance (#66).
model alliance_list_entries {
  id             Int              @id @default(autoincrement())
  alliance_id    Int
  list_type      AllianceListType
  target_user_id Int
  note           String?          @db.VarChar(200)
  added_by       Int
  created_at     DateTime         @default(now()) @db.Timestamptz(3)

  alliance    alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  target_user users     @relation("AllianceListTarget", fields: [target_user_id], references: [id], onDelete: Cascade)

  @@unique([alliance_id, list_type, target_user_id], name: "unique_alliance_list_target")
  @@index([alliance_id, list_type], map: "idx_alliance_list_entries_list")
  @@index([target_user_id], map: "idx_alliance_list_entries_target")
}

/// Ally relation between two alliances; alliance_id is the requester (#66).
model alliance_relations {
  id                Int                    @id @default(autoincrement())
  alliance_id       Int
  other_alliance_id Int
  status            AllianceRelationStatus @default(PENDING)
  requested_by      Int
  created_at        DateTime               @default(now()) @db.Timestamptz(3)
  accepted_at       DateTime?              @db.Timestamptz(3)

  alliance       alliances @relation("RelationOwner", fields: [alliance_id], references: [id], onDelete: Cascade)
  other_alliance alliances @relation("RelationOther", fields: [other_alliance_id], references: [id], onDelete: Cascade)

  @@unique([alliance_id, other_alliance_id], name: "unique_alliance_relation")
  @@index([other_alliance_id], map: "idx_alliance_relations_other")
}

enum AllianceCallType {
  HIT
  FARM
  RECON
}

enum AllianceCallStatus {
  OPEN
  CLOSED
}

/// Hit / Farm / Recon calls raised against a non-member target (#66).
model alliance_target_calls {
  id             Int                @id @default(autoincrement())
  alliance_id    Int
  target_user_id Int
  call_type      AllianceCallType
  status         AllianceCallStatus @default(OPEN)
  note           String?            @db.VarChar(200)
  created_by     Int
  created_at     DateTime           @default(now()) @db.Timestamptz(3)
  closed_at      DateTime?          @db.Timestamptz(3)

  alliance    alliances               @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  target_user users                   @relation("AllianceCallTarget", fields: [target_user_id], references: [id], onDelete: Cascade)
  shares      alliance_intel_shares[]

  @@index([alliance_id, status, created_at], map: "idx_alliance_calls_status")
  @@index([target_user_id], map: "idx_alliance_calls_target")
}

/// A battle or spy report shared with an alliance, optionally attached to a call (#66).
model alliance_intel_shares {
  id            Int      @id @default(autoincrement())
  alliance_id   Int
  attack_log_id Int
  shared_by     Int
  note          String?  @db.VarChar(200)
  call_id       Int?
  is_threat     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  alliance   alliances              @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  attack_log attack_log             @relation(fields: [attack_log_id], references: [id], onDelete: Cascade)
  call       alliance_target_calls? @relation(fields: [call_id], references: [id], onDelete: SetNull)

  @@unique([alliance_id, attack_log_id], name: "unique_alliance_intel_share")
  @@index([alliance_id, created_at], map: "idx_alliance_intel_feed")
  @@index([call_id], map: "idx_alliance_intel_call")
}

// Temporary forces (#10). Ownership ledger only until combat/lifecycle adapters
// are enabled; these rows must never be copied into permanent UserUnit holdings.
enum ForceContractKind {
  MERCENARY
  ALLIANCE
}

enum ForceContractStatus {
  REQUESTED
  ACTIVE
  EXPIRED
  RECALLED
  DISMISSED
  DEPLETED
  CANCELLED
}

model ForceReserve {
  id              Int             @id @default(autoincrement())
  allianceId      Int
  type            UnitType
  level           Int
  loadoutKey      String          @db.VarChar(64)
  equipment       Json
  available       Int             @default(0)
  eraId           Int?
  woundedQuantity Int             @default(0)
  lastHealedAt    DateTime        @default(now()) @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  alliance        alliances       @relation(fields: [allianceId], references: [id], onDelete: Restrict)
  contracts       ForceContract[]

  @@unique([allianceId, type, level, loadoutKey])
  @@unique([id, allianceId])
}

model ForceContract {
  id                     Int                  @id @default(autoincrement())
  kind                   ForceContractKind
  status                 ForceContractStatus  @default(REQUESTED)
  userId                 Int
  allianceId             Int?
  reserveId              Int?
  type                   UnitType
  level                  Int
  equipment              Json
  eraId                  Int?
  requestedExtensionDays Int?
  initialQuantity        Int
  survivingQuantity      Int
  termDays               Int
  startsAt               DateTime?            @db.Timestamptz(3)
  expiresAt              DateTime?            @db.Timestamptz(3)
  closedAt               DateTime?            @db.Timestamptz(3)
  pillageRateBps         Int                  @default(0)
  unitPriceGold          BigInt               @default(0)
  policyVersion          Int?
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  user                   users                @relation(fields: [userId], references: [id], onDelete: Restrict)
  alliance               alliances?           @relation(fields: [allianceId], references: [id], onDelete: Restrict)
  reserve                ForceReserve?        @relation(fields: [reserveId, allianceId], references: [id, allianceId], onDelete: Restrict)
  events                 ForceEvent[]
  policy                 AllianceForcePolicy? @relation(fields: [allianceId, policyVersion], references: [allianceId, version], onDelete: Restrict, map: "ForceContract_policy_fkey")

  @@index([userId, status, expiresAt])
  @@index([allianceId, status])
  @@index([status, expiresAt])
}

model ForceEvent {
  id           Int            @id @default(autoincrement())
  operationKey String         @unique @db.VarChar(128)
  allianceId   Int?
  contractId   Int?
  actorId      Int?
  action       String         @db.VarChar(40)
  quantity     Int            @default(0)
  gold         BigInt         @default(0)
  details      Json
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  alliance     alliances?     @relation(fields: [allianceId], references: [id], onDelete: Restrict)
  contract     ForceContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  actor        users?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([allianceId, createdAt])
  @@index([contractId, createdAt])
}

// Immutable snapshots: edits append a version; accepted loans keep their terms.
model AllianceForcePolicy {
  id         Int             @id @default(autoincrement())
  allianceId Int
  version    Int
  settings   Json
  contracts  ForceContract[]
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  alliance   alliances       @relation(fields: [allianceId], references: [id], onDelete: Restrict)

  @@unique([allianceId, version])
}

model ForceLedgerArchive {
  id         Int      @id @default(autoincrement())
  allianceId Int
  snapshot   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([allianceId])
}

model ForceObligation {
  id                  Int       @id @default(autoincrement())
  allianceId          Int
  userId              Int
  eraId               Int?
  enforcement         Json      @default("{}")
  alliance            alliances @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  user                users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKey           String    @unique @db.VarChar(128)
  title               String    @db.VarChar(120)
  amountGold          BigInt    @default(0)
  paidGold            BigInt    @default(0)
  quantity            Int       @default(0)
  paidQuantity        Int       @default(0)
  type                UnitType?
  level               Int?
  dueAt               DateTime  @db.Timestamptz(3)
  fineGold            BigInt    @default(0)
  paidFineGold        BigInt    @default(0)
  fineAssessedAt      DateTime? @db.Timestamptz(3)
  reminderAt          DateTime? @db.Timestamptz(3)
  cancelledAt         DateTime? @db.Timestamptz(3)
  collectionUnitId    Int?
  collectionEquipment Json?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  @@index([allianceId, userId, dueAt])
}

model ForceDuesRule {
  id           Int       @id @default(autoincrement())
  allianceId   Int
  alliance     alliances @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  roleId       Int
  minLevel     Int       @default(1)
  amountGold   BigInt    @default(0)
  quantity     Int       @default(0)
  type         UnitType?
  level        Int?
  intervalDays Int       @default(7)
  dueDays      Int       @default(3)
  nextIssueAt  DateTime  @default(now()) @db.Timestamptz(3)
  enabled      Boolean   @default(true)

  @@unique([allianceId, roleId, minLevel])
  @@index([nextIssueAt, enabled])
}
