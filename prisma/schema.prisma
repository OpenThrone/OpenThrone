generator client {
  provider      = "prisma-client"
  output        = "./generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  VACATION
  CLOSED
  IDLE
  INACTIVE
  RESET
  BANNED
  TIMEOUT
  SUSPENDED
}

enum StaffRole {
  ADMINISTRATOR
  MODERATOR
  COMMUNITY_MANAGER
  GAME_MASTER
}

enum PermissionType {
  // Dashboard & Audit
  VIEW_STAFF_DASHBOARD
  VIEW_AUDIT_LOGS

  // User Management
  MANAGE_USERS
  MANAGE_ACCOUNT_STATUS
  MANAGE_MODERATOR_NOTES
  MANAGE_BAN_APPEALS

  // Moderation
  REVIEW_REPORTS
  ASSIGN_REPORTS
  MODERATE_CHAT
  VIEW_CHAT_LOGS

  // Content
  MANAGE_ANNOUNCEMENTS
  MANAGE_CONTENT
  SEND_MASS_MESSAGES

  // Game
  MANAGE_EVENTS
  MANAGE_ERAS
  MANAGE_ALLIANCES

  // Analytics & Abuse
  VIEW_ECONOMY
  VIEW_ANALYTICS
  VIEW_MULTI_ACCOUNTS
  VIEW_CHEAT_SIGNALS

  // System
  MANAGE_FEATURE_FLAGS
  MANAGE_SERVER_SETTINGS
  MANAGE_API_TOKENS
  USE_IMPERSONATION
}

enum ReportCategory {
  HARASSMENT
  SPAM
  CHEATING
  MULTI_ACCOUNT
  BUG_EXPLOIT
  INAPPROPRIATE_NAME
  CHAT_ABUSE
  ALLIANCE_ABUSE
  OTHER
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportStatus {
  OPEN
  TRIAGED
  IN_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ReportResolution {
  NO_ACTION
  WARNING
  CHAT_MUTE
  SUSPENSION
  BAN
  APPEAL_REFERRED
  OTHER
}

enum ReportActionType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  NOTE_ADDED
  EVIDENCE_ADDED
  USER_WARNED
  USER_MUTED
  USER_SUSPENDED
  USER_BANNED
  RESOLVED
  DISMISSED
}

enum ModeratorNoteVisibility {
  STAFF
  ADMINS_ONLY
}

enum AnnouncementSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum GameEventType {
  GOLD_MODIFIER
  TURN_MODIFIER
  UNIT_COST_MODIFIER
  BUILD_SPEED_MODIFIER
  PVP_MODIFIER
  CUSTOM
}

enum GameEventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum BanAppealStatus {
  OPEN
  IN_REVIEW
  ACCEPTED
  DENIED
  WITHDRAWN
}

enum ServerSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InvestigationStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
  ACTION_TAKEN
}

enum CheatSignalType {
  IMPOSSIBLE_ACTION
  GOLD_SPIKE
  SELF_FARMING
  TRANSFER_RING
  LINKED_ACCOUNT_ACTIVITY
  CHAT_SPAM
  ALLIANCE_BANK_ABUSE
  DEFECTOR_FARMING
}

enum AllianceJoinMode {
  OPEN
  REQUEST_TO_JOIN
  INVITE_ONLY
}

enum AllianceRosterVisibility {
  PUBLIC
  MEMBERS_ONLY
}

enum WarStatus {
  WARMUP
  ACTIVE
  COOLDOWN
  ENDED
}

enum AllianceCooldownType {
  LEAVE
  KICK
}

enum AllianceTransactionType {
  DEPOSIT
  WITHDRAWAL
  TAX
  FEE
  LOAN
  LOAN_REPAYMENT
}

enum AllianceLoanStatus {
  REQUESTED
  ACTIVE
  REPAID
  DEFAULTED
  WRITTEN_OFF
  DECLINED
  CANCELLED
}

enum AllianceGoldRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ApiClientType {
  USER
  SYSTEM
  SERVICE
}

enum ApiClientStatus {
  ACTIVE
  DISABLED
}

model users {
  id                                    Int                      @id @default(autoincrement())
  email                                 String                   @unique
  display_name                          String                   @unique
  password_hash                         String
  twoFactorSecret                       String?
  race                                  String
  class                                 String
  experience                            Int                      @default(0)
  gold                                  BigInt                   @default(25000)
  gold_in_bank                          BigInt                   @default(0)
  fort_level                            Int                      @default(1)
  fort_hitpoints                        Int                      @default(50)
  attack_turns                          Int                      @default(50)
  stamina                               Int                      @default(100)
  maxStamina                            Int                      @default(100)
  defense_pressure_today                Int                      @default(0)
  defense_pressure_date                 DateTime?                @db.Timestamptz(3)
  spy_pressure_today                    Int                      @default(0)
  spy_pressure_date                     DateTime?                @db.Timestamptz(3)
  /// Kingdom morale 0-100 (#205): drives citizen departure, desertion and defection.
  kingdom_morale                        Int                      @default(100)
  /// Trained-army size recorded the first time morale dropped below the desertion threshold this era; cleared only on era reset.
  desertion_floor                       Int?
  /// OT day key (YYYY-MM-DD) the daily morale pass last applied for; guards one application per player per OT day.
  kingdom_morale_day                    String?
  /// Undead reanimation (#211): units that rose again this OT day, across all battles.
  reanimated_today                      Int                      @default(0)
  /// OT day key (YYYY-MM-DD) the reanimation ledger was last reset for; guards the daily cap like kingdom_morale_day guards the morale pass.
  reanimation_day                       String?
  /// The day's cap: 2% of the trained combat army measured at the first battle of the OT day.
  reanimation_cap                       Int                      @default(0)
  wounded_units                         Json                     @default("[]")
  last_active                           DateTime?                @db.Timestamptz(3)
  last_gameplay_at                      DateTime?                @db.Timestamptz(3)
  rank                                  Int                      @default(0)
  house_level                           Int                      @default(0)
  bio                                   String                   @default("")
  colorScheme                           String?
  recruit_link                          String                   @unique @default("")
  locale                                String
  economy_level                         Int                      @default(0)
  avatar                                String?                  @default("SHIELD")
  created_at                            DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                            DateTime?                @default(now()) @updatedAt @db.Timestamp(6)
  stats                                 Json?
  killing_str                           Int?                     @default(1)
  defense_str                           Int?                     @default(1)
  spying_str                            Int?                     @default(1)
  sentry_str                            Int?                     @default(1)
  offense                               Int?                     @default(0)
  defense                               Int?                     @default(0)
  spy                                   Int?                     @default(0)
  sentry                                Int?                     @default(0)
  accountResetsAsNewUser                AccountResetHistory[]    @relation("NewUserAfterReset")
  resetHistories                        AccountResetHistory[]
  enforcedStatusChanges                 AccountStatusHistory[]   @relation("AccountStatusAdmin")
  statusHistories                       AccountStatusHistory[]
  AutoRecruitSession                    AutoRecruitSession[]
  passwordResets                        PasswordReset[]
  permissions                           PermissionGrant[]        @relation("PermissionGrants")
  alliance_memberships                  alliance_memberships[]
  alliance_announcements                alliance_announcements[] @relation("AllianceAnnouncementAuthor")
  ledAlliances                          alliances[]              @relation("AllianceLeader")
  attacksMade                           attack_log[]             @relation("AttackLogs")
  attacksDefended                       attack_log[]             @relation("DefenseLogs")
  sharedAttackLogs                      attack_log_acl[]         @relation("SharedAttackLogs")
  blogPosts                             blog_posts[]
  advisorMessages                       advisor_messages[]
  messages_messages_from_user_idTousers messages[]               @relation("messages_from_user_idTousers")
  messages_messages_to_user_idTousers   messages[]               @relation("messages_to_user_idTousers")
  postReadStatuses                      post_read_status[]
  recruitHistoriesFrom                  recruit_history[]        @relation("FromUserRelation")
  recruitHistoriesTo                    recruit_history[]        @relation("ToUserRelation")
  recruitHistories                      recruit_history[]
  socialRelationsAsFriend               social[]                 @relation("FriendRelations")
  socialRelationsAsPlayer               social[]                 @relation("PlayerRelations")
  ChatRoom                              ChatRoom[]
  ChatRoomParticipant                   ChatRoomParticipant[]
  ChatMessage                           ChatMessage[]
  messageReactions                      ChatMessageReaction[] // Added for reactions
  readMessages                          ChatMessageReadStatus[] // Added for read receipts
  auditLogs                             AuditLog[]               @relation("AuditLogs")
  userEras                              UserEra[]                @relation("UserEraUsers")
  currentEraId                          Int?
  /// When the player entered (or last reset into) their current era; starts the new-player protection clock. Null on legacy rows.
  era_joined_at                         DateTime?                @db.Timestamptz(3)
  /// Era in which the player forfeited protection by attacking a non-protected player.
  /// Citizens this era from timed citizen events and citizen multipliers (#89); added to the protection population limit.
  event_citizens_received               Int                      @default(0)
  protection_forfeited_era_id           Int?
  achievements                          Json?                    @default("{}")
  /// New-player tutorial progress ({@link TutorialState}); account-wide so clearing browser data cannot replay it. Null until the player first answers the offer.
  tutorial_state                        Json?
  currentEra                            Era?                     @relation("CurrentUserEra", fields: [currentEraId], references: [id])

  // New relations to structured data
  forceObligations     ForceObligation[]
  forceContracts       ForceContract[]
  forceEvents          ForceEvent[]
  UserUnit             UserUnit[]
  UserItem             UserItem[]
  UserStructureUpgrade UserStructureUpgrade[]
  UserBattleUpgrade    UserBattleUpgrade[]
  UserBonusPoints      UserBonusPoints[]
  apiClients           ApiClient[]

  // Alliance System Relations
  allianceJoinRequests        alliance_join_requests[]
  allianceCooldowns           alliance_cooldowns[]
  declaredAllianceWars        alliance_wars[]          @relation("DeclaredWars")
  allianceListEntriesTargeted alliance_list_entries[]  @relation("AllianceListTarget")
  allianceTargetCalls         alliance_target_calls[]  @relation("AllianceCallTarget")
  targetedInOneUserWars       alliance_wars[]          @relation("WarTargetUser") // War where user is the specific target
  targetedInWars              war_targets[] // Specific targets within a war
  bankHistoryPerformed        alliance_bank_history[]  @relation("PerformedBy")
  bankHistoryRelated          alliance_bank_history[]  @relation("RelatedUser")
  allianceGoldRequests        alliance_gold_requests[] @relation("GoldRequester")
  allianceGoldRequestsDecided alliance_gold_requests[] @relation("GoldRequestDecider")
  allianceLoansBorrowed       alliance_loans[]         @relation("LoanBorrower")
  allianceLoansDecided        alliance_loans[]         @relation("LoanDecider")

  // Staff & Moderation Relations
  staffRoleAssignments    StaffRoleAssignment[] @relation("StaffRoleAssignments")
  staffRoleGrantedBy      StaffRoleAssignment[] @relation("StaffRoleGrantedBy")
  permissionGrantedBy     PermissionGrant[]     @relation("PermissionGrantedBy")
  reportsFiled            Report[]              @relation("ReportsFiled")
  reportsAgainst          Report[]              @relation("ReportsAgainst")
  reportsAssigned         Report[]              @relation("ReportsAssigned")
  reportsResolved         Report[]              @relation("ReportsResolved")
  reportActions           ReportAction[]        @relation("ReportActions")
  moderatorNotesOnUser    ModeratorNote[]       @relation("ModeratorNotesOnUser")
  moderatorNotesByUser    ModeratorNote[]       @relation("ModeratorNotesByUser")
  banAppealsFiled         BanAppeal[]           @relation("BanAppealsFiled")
  banAppealsAssigned      BanAppeal[]           @relation("BanAppealsAssigned")
  banAppealsDecided       BanAppeal[]           @relation("BanAppealsDecided")
  announcementsCreated    Announcement[]        @relation("AnnouncementsCreated")
  announcementsUpdated    Announcement[]        @relation("AnnouncementsUpdated")
  gameEventsCreated       GameEvent[]           @relation("GameEventsCreated")
  gameEventsUpdated       GameEvent[]           @relation("GameEventsUpdated")
  chatMutesOnUser         ChatMute[]            @relation("ChatMutesOnUser")
  chatMutesCreatedBy      ChatMute[]            @relation("ChatMutesCreatedBy")
  chatMutesRevokedBy      ChatMute[]            @relation("ChatMutesRevokedBy")
  loginEvents             LoginEvent[]          @relation("LoginEventsOnUser")
  cheatSignalsOnUser      CheatSignal[]         @relation("CheatSignalsOnUser")
  cheatSignalsRelatedUser CheatSignal[]         @relation("CheatSignalsRelatedUser")
  cheatSignalsAssigned    CheatSignal[]         @relation("CheatSignalsAssigned")
  cheatSignalsResolved    CheatSignal[]         @relation("CheatSignalsResolved")
  featureFlagsCreated     FeatureFlag[]         @relation("FeatureFlagsCreated")
  featureFlagsUpdated     FeatureFlag[]         @relation("FeatureFlagsUpdated")
  serverSettingsUpdated   ServerSetting[]       @relation("ServerSettingsUpdated")

  // Email and identity lifecycle relations
  emailPreference          EmailPreference?
  emailCampaignsCreated    EmailCampaign[]           @relation("EmailCampaignsCreated")
  emailOutbox              EmailOutbox[]
  emailSuppressionsCreated EmailSuppression[]        @relation("EmailSuppressionsCreated")
  accountInactivityNotice  AccountInactivityNotice?  @relation("InactivityNoticeOnUser")
  inactivityNoticesCreated AccountInactivityNotice[] @relation("InactivityNoticesCreated")
  identityBlocks           IdentityBlock[]           @relation("IdentityBlocksSource")

  //Migration step
  units              Json? // Don't delete yet
  items              Json? // Don't delete yet
  battle_upgrades    Json? // Don't delete yet
  structure_upgrades Json? // Don't delete yet
  bonus_points       Json? // Don't delete yet

  // Kingdom morale (#205)
  desertionEvents       DesertionEvent[] @relation("DesertionEvents")
  desertionsReceived    DesertionEvent[] @relation("DesertionDefections")

  // Dungeon captives (#210)
  captivesHeld          Captive[]       @relation("CaptivesHeld")
  captivesLost          Captive[]       @relation("CaptivesLost")
  captiveEventsAsCaptor CaptiveEvent[]  @relation("CaptorCaptiveEvents")
  captiveEventsAsSource CaptiveEvent[]  @relation("SourceCaptiveEvents")

  // Bot user system fields (see .sisyphus/plans/bot-users-system.md)
  // isBot is non-null with default false so scheduler queries can use WHERE isBot = true efficiently.
  isBot        Boolean   @default(false)
  botPersona   String?
  botConfig    Json?
  botCreatedAt DateTime? @db.Timestamptz(3)
  botLastRunAt DateTime? @db.Timestamptz(3)
  botStats     Json?

  @@index([created_at])
  @@index([currentEraId])
  @@index([isBot])
  @@index([currentEraId, last_gameplay_at])
}

model AccountStatusHistory {
  id         Int           @id @default(autoincrement())
  user_id    Int
  status     AccountStatus
  start_date DateTime      @default(now()) @db.Timestamp(6)
  end_date   DateTime?     @db.Timestamp(6)
  reason     String?
  admin_id   Int?
  created_at DateTime      @default(now()) @db.Timestamp(6)
  updated_at DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  admin      users?        @relation("AccountStatusAdmin", fields: [admin_id], references: [id])
  user       users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  appeals    BanAppeal[]

  @@index([user_id, start_date])
}

model AccountResetHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  resetDate DateTime @default(now()) @db.Timestamptz(3)
  newUserId Int?
  reason    String?
  newUser   users?   @relation("NewUserAfterReset", fields: [newUserId], references: [id])
  user      users    @relation(fields: [userId], references: [id])

  @@index([userId, resetDate])
}

model AntiAbuseShadow {
  id        Int       @id @default(autoincrement())
  hash      String    @unique
  reason    String?
  ipHash    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)
}

model social {
  id               Int       @id @default(autoincrement())
  playerId         Int
  friendId         Int
  relationshipType String
  requestDate      DateTime  @default(now()) @db.Timestamptz(6)
  acceptanceDate   DateTime? @db.Timestamptz(6)
  endDate          DateTime? @db.Timestamptz(6)
  status           String    @default("requested")
  friend           users     @relation("FriendRelations", fields: [friendId], references: [id])
  player           users     @relation("PlayerRelations", fields: [playerId], references: [id])

  @@index([friendId], map: "idx_social_friendId")
  @@index([playerId], map: "idx_social_playerId")
}

model PasswordReset {
  id               Int      @id @default(autoincrement())
  userId           Int
  verificationCode String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  status           Int      @default(0) // 0 = Active, 1 = Used, 2 = Expired
  type             String   @default("'PASSWORD'::text")
  oldEmail         String?  @default("NULL")
  user             users    @relation(fields: [userId], references: [id])
}

model attack_log {
  id                    Int                     @id @default(autoincrement())
  attacker_id           Int
  defender_id           Int
  timestamp             DateTime?               @db.Timestamptz(3)
  winner                Int
  stats                 Json
  type                  String                  @default("attack")
  pillaged_gold         BigInt?
  attacker_losses_total Int?
  defender_losses_total Int?
  attackerPlayer        users                   @relation("AttackLogs", fields: [attacker_id], references: [id])
  defenderPlayer        users                   @relation("DefenseLogs", fields: [defender_id], references: [id])
  acl                   attack_log_acl[]
  chatMessages          ChatMessage[] // Added for shared logs relation
  intelShares           alliance_intel_shares[]

  @@index([attacker_id, defender_id, timestamp])
  @@index([attacker_id])
  @@index([defender_id])
  @@index([winner])
  @@index([type, timestamp])
}

model bank_history {
  id                     Int       @id @default(autoincrement())
  gold_amount            BigInt
  from_user_id           Int
  from_user_account_type String
  to_user_id             Int
  to_user_account_type   String
  date_time              DateTime? @db.Timestamptz(3)
  history_type           String
  stats                  Json?     @default("[]")

  @@index([from_user_id, to_user_id, date_time])
}

enum RecruitmentSource {
  INTERNAL
  EXTERNAL
}

model recruit_history {
  source RecruitmentSource @default(INTERNAL)
  id           Int       @id @default(autoincrement())
  from_user    Int?
  to_user      Int
  ip_addr      String
  timestamp    DateTime? @db.Timestamptz(3)
  usersId      Int?
  from_userObj users?    @relation("FromUserRelation", fields: [from_user], references: [id])
  to_userObj   users     @relation("ToUserRelation", fields: [to_user], references: [id])
  users        users?    @relation(fields: [usersId], references: [id])

  @@index([to_user, from_user, timestamp])
  @@index([source, to_user, timestamp])
  @@index([source, to_user, ip_addr, timestamp])
  @@index([source, ip_addr, timestamp])
}

model blog_posts {
  id                Int                @id @default(autoincrement())
  title             String
  created_timestamp DateTime           @default(now()) @db.Timestamptz(3)
  updated_timestamp DateTime           @updatedAt @db.Timestamptz(3)
  postedby_id       Int
  content           String
  slug              String?            @unique
  status            String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  kind              String             @default("BLOG") // BLOG, NEWS, CHANGELOG
  excerpt           String?
  publishedAt       DateTime?          @db.Timestamptz(3)
  isPinned          Boolean            @default(false)
  postedBy          users              @relation(fields: [postedby_id], references: [id])
  postReadStatus    post_read_status[]

  @@index([status, publishedAt])
  @@index([kind, status])
}

model post_read_status {
  post_id      Int
  last_read_at DateTime   @db.Timestamptz(3)
  user_id      Int
  post         blog_posts @relation(fields: [post_id], references: [id])
  user         users      @relation(fields: [user_id], references: [id])

  @@id([post_id, user_id])
}

model advisor_messages {
  id         Int      @id @default(autoincrement())
  message    String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)
  created_by Int
  createdBy  users    @relation(fields: [created_by], references: [id])

  @@index([is_active, sort_order])
}

model attack_log_acl {
  id                      Int        @id @default(autoincrement())
  attack_log_id           Int
  is_public               Boolean    @default(false)
  shared_with_user_id     Int?
  shared_with_alliance_id Int?
  attack_log              attack_log @relation(fields: [attack_log_id], references: [id])
  shared_with_alliance    alliances? @relation(fields: [shared_with_alliance_id], references: [id])
  shared_with_user        users?     @relation("SharedAttackLogs", fields: [shared_with_user_id], references: [id])

  @@index([shared_with_user_id], map: "idx_acl_user")
  @@index([shared_with_alliance_id], map: "idx_acl_alliance")
}

model alliances {
  id                Int                    @id @default(autoincrement())
  name              String
  leader_id         Int
  avatar            String?                @db.VarChar(255)
  motto             String?
  comments          String?
  is_public         Boolean                @default(true)
  require_auth      Boolean                @default(false)
  closed_enrollment Boolean                @default(false)
  gold_in_bank      BigInt?                @default(0)
  created_at        DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  bannerimg         String?                @db.VarChar
  slug              String?
  forceObligations  ForceObligation[]
  forceDuesRules    ForceDuesRule[]
  forceReserves     ForceReserve[]
  forceContracts    ForceContract[]
  forceEvents       ForceEvent[]
  forcePolicies     AllianceForcePolicy[]
  members           alliance_memberships[]
  alliance_roles    alliance_roles[]
  leader            users                  @relation("AllianceLeader", fields: [leader_id], references: [id])
  sharedAttackLogs  attack_log_acl[]
  chatRooms         ChatRoom[] // Added for alliance chat relation

  // New Fields
  join_mode            AllianceJoinMode         @default(OPEN)
  roster_visibility    AllianceRosterVisibility @default(PUBLIC)
  war_tax_mode         String                   @default("ALLIANCE") // ALLIANCE or ROLE (Keep flexible as string for now or Enum if strict)
  war_tax_rate_default Int                      @default(0) // 0-25

  // Treasury loan terms and per-member daily outflow cap (#66 phase 3)
  loan_term_days    Int    @default(7)
  loan_interest_pct Int    @default(10)
  member_daily_cap  BigInt @default(5000000)

  // New Relations
  join_requests  alliance_join_requests[]
  cooldowns      alliance_cooldowns[] // Global cooldowns might not have alliance_id, but alliance-specific ones will
  declared_wars  alliance_wars[]          @relation("AttackerAlliance")
  defending_wars alliance_wars[]          @relation("DefenderAlliance")
  bank_history   alliance_bank_history[]
  gold_requests  alliance_gold_requests[]
  loans          alliance_loans[]
  fees           alliance_fees[]
  xp_record      alliance_xp?
  upgrades       alliance_upgrades[]
  list_entries   alliance_list_entries[]
  relations_out  alliance_relations[]     @relation("RelationOwner")
  relations_in   alliance_relations[]     @relation("RelationOther")
  announcements  alliance_announcements[]
  target_calls   alliance_target_calls[]
  intel_shares   alliance_intel_shares[]

  @@index([leader_id], map: "idx_alliance_leader")
}

model alliance_announcements {
  id          Int       @id @default(autoincrement())
  alliance_id Int
  author_id   Int
  title       String    @db.VarChar(120)
  body        String    @db.VarChar(4000)
  pinned      Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  alliance    alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  author      users     @relation("AllianceAnnouncementAuthor", fields: [author_id], references: [id])

  @@index([alliance_id, created_at], map: "idx_alliance_announcements_alliance_created")
}

model alliance_memberships {
  id          Int            @id @default(autoincrement())
  alliance_id Int
  user_id     Int
  role_id     Int
  created_at  DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  alliance    alliances      @relation(fields: [alliance_id], references: [id])
  role        alliance_roles @relation(fields: [role_id], references: [id])
  user        users          @relation(fields: [user_id], references: [id])

  @@unique([alliance_id, user_id], name: "unique_alliance_user")
  @@index([user_id], map: "idx_membership_user")
  @@index([alliance_id], map: "idx_membership_alliance")
  @@index([role_id], map: "idx_membership_role")
}

model alliance_roles {
  id          Int                    @id @default(autoincrement())
  name        String
  alliance_id Int
  created_at  DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  permissions Json?                  @default("{\"invite_member\": false, \"grant_access\": false, \"edit_ranks\": false, \"send_messages\": false, \"edit_profile\": false, \"manage_allies\": false, \"manage_enemies\": false, \"edit_list\": false, \"view_list\": false}") @db.Json
  /// Rank position within the alliance; lower is higher. The default role is last.
  rank_order  Int                    @default(0)
  members     alliance_memberships[]
  alliance    alliances              @relation(fields: [alliance_id], references: [id])

  @@index([alliance_id], map: "idx_role_alliance")
}

model PermissionGrant {
  id              Int            @id @default(autoincrement())
  user_id         Int
  type            PermissionType
  grantedByUserId Int?
  sourceRole      StaffRole?
  note            String?
  created_at      DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?      @db.Timestamptz(3)

  user      users  @relation("PermissionGrants", fields: [user_id], references: [id], onDelete: Cascade)
  grantedBy users? @relation("PermissionGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([user_id, revokedAt])
  @@index([type, revokedAt])
}

model AutoRecruitSession {
  id             Int      @id @default(autoincrement())
  userId         Int
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @updatedAt
  user           users    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model messages {
  id                                 Int       @id @default(autoincrement())
  subject                            String
  from_user_id                       Int
  to_user_id                         Int
  date_time                          DateTime? @default(now()) @db.Timestamptz(3)
  created_date                       DateTime? @default(now()) @db.Timestamptz(3)
  updated_date                       DateTime? @default(now()) @db.Timestamptz(3)
  body                               String
  unread                             Boolean   @default(true)
  users_messages_from_user_idTousers users     @relation("messages_from_user_idTousers", fields: [from_user_id], references: [id])
  users_messages_to_user_idTousers   users     @relation("messages_to_user_idTousers", fields: [to_user_id], references: [id])
}

model ChatRoom {
  id           Int                   @id @default(autoincrement())
  name         String? // Optional room name (e.g., for group chats)
  isPrivate    Boolean               @default(true) // If true, only participants can join
  createdById  Int // User who created the room
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  participants ChatRoomParticipant[]
  messages     ChatMessage[]
  creator      users                 @relation(fields: [createdById], references: [id])
  allianceId   Int? // Added for alliance specific rooms
  alliance     alliances?            @relation(fields: [allianceId], references: [id], onDelete: Cascade) // Added for alliance specific rooms
  reports      Report[]
  chatMutes    ChatMute[]

  @@index([createdById])
}

model ChatRoomParticipant {
  id       Int      @id @default(autoincrement())
  roomId   Int // ChatRoom ID
  userId   Int // Participant ID
  role     ChatRole @default(MEMBER) // Role in the room (e.g., ADMIN, MEMBER)
  joinedAt DateTime @default(now())
  canWrite Boolean  @default(true) // Whether the user can send messages
  room     ChatRoom @relation(fields: [roomId], references: [id])
  user     users    @relation(fields: [userId], references: [id])

  @@unique([roomId, userId]) // Each user can only join a room once
}

model ChatMessage {
  id                Int      @id @default(autoincrement())
  roomId            Int // ChatRoom ID
  senderId          Int // User who sent the message
  content           String // Plain text for notifications and search
  richContent       Json? // Versioned, validated rich message document
  clientMessageId   String? @db.VarChar(64) // Stable across send retries
  sentAt            DateTime @default(now())
  messageType       String   @default("TEXT") // Added: e.g., TEXT, ATTACK_LOG_SHARE
  replyToMessageId  Int? // Added for replies
  sharedAttackLogId Int? // Added for sharing attack logs

  // Moderation fields
  deletedAt         DateTime? @db.Timestamptz(3)
  deletedByUserId   Int?
  moderatedByUserId Int?
  editReason        String?
  originalContent   String?

  room            ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade) // Added onDelete Cascade
  sender          users        @relation(fields: [senderId], references: [id], onDelete: Cascade) // Added onDelete Cascade
  replyToMessage  ChatMessage? @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction) // Added for replies
  sharedAttackLog attack_log?  @relation(fields: [sharedAttackLogId], references: [id], onDelete: SetNull) // Added for sharing attack logs

  replies   ChatMessage[]           @relation("MessageReplies") // Added for replies
  reactions ChatMessageReaction[] // Added for reactions
  readBy    ChatMessageReadStatus[] // Added for read receipts
  reports   Report[]

  @@unique([roomId, senderId, clientMessageId])
  @@index([roomId, sentAt])
  @@index([roomId, id])
  @@index([replyToMessageId]) // Added index
  @@index([sharedAttackLogId]) // Added index
}

model ChatMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  reaction  String // Consider using an enum if the set of reactions is fixed
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction]) // Prevent duplicate reactions per user per message
  @@index([messageId])
  @@index([userId])
}

model ChatMessageReadStatus {
  messageId Int
  userId    Int
  readAt    DateTime @updatedAt // Use @updatedAt to track the latest read time

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    users       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId]) // Composite primary key ensures one read status per user per message
  @@index([userId]) // Index for querying user's read statuses quickly
}

enum ChatRole {
  ADMIN
  MEMBER
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  action       String
  ip           String
  ipHash       String?
  timestamp    DateTime @default(now()) @db.Timestamptz(3)
  details      Json?
  targetUserId Int?
  entityType   String?
  entityId     Int?
  requestId    String?
  user         users    @relation("AuditLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([targetUserId, timestamp])
  @@index([action, timestamp])
}

model ApiClient {
  id          Int             @id @default(autoincrement())
  ownerUserId Int?
  name        String
  clientType  ApiClientType   @default(USER)
  status      ApiClientStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  lastUsedAt  DateTime?       @db.Timestamptz(3)
  ownerUser   users?          @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  tokens      ApiToken[]

  @@index([ownerUserId])
  @@index([status])
}

model ApiToken {
  id          Int             @id @default(autoincrement())
  clientId    Int
  tokenPrefix String          @unique
  tokenHash   String
  scopes      String[]
  expiresAt   DateTime?       @db.Timestamptz(3)
  revokedAt   DateTime?       @db.Timestamptz(3)
  lastUsedAt  DateTime?       @db.Timestamptz(3)
  lastIpHash  String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  client      ApiClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  audits      ApiTokenAudit[]

  @@index([clientId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model ApiTokenAudit {
  id         Int      @id @default(autoincrement())
  tokenId    Int
  action     String
  route      String
  method     String
  statusCode Int
  ipHash     String?
  uaHash     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  token      ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, createdAt])
  @@index([route, createdAt])
}

model Era {
  id            Int         @id @default(autoincrement())
  name          String
  startDate     DateTime    @default(now()) @db.Timestamptz(3)
  endDate       DateTime?   @db.Timestamptz(3)
  startSettings Json?
  users         users[]     @relation("CurrentUserEra")
  userEras      UserEra[]   @relation("UserEraEras")
  gameEvents    GameEvent[]

  @@index([startDate])
}

model UserEra {
  id                Int      @id @default(autoincrement())
  userId            Int
  eraId             Int
  levelAtStart      Int      @default(1)
  unitsAtStart      Json     @default("[]")
  achievements      Json     @default("{}")
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  rankAtEnd         Int?
  goldAtEnd         BigInt?  @db.BigInt
  goldInBankAtEnd   BigInt?  @db.BigInt
  offenseAtEnd      Int?
  defenseAtEnd      Int?
  spyAtEnd          Int?
  sentryAtEnd       Int?
  fortLevelAtEnd    Int?
  houseLevelAtEnd   Int?
  economyLevelAtEnd Int?
  levelAtEnd        Int?
  snapshotAtEnd     Json?
  user              users    @relation("UserEraUsers", fields: [userId], references: [id], onDelete: Cascade)
  era               Era      @relation("UserEraEras", fields: [eraId], references: [id], onDelete: Cascade)

  @@unique([userId, eraId])
  @@index([userId])
  @@index([eraId])
}

// This file contains the schema for the JSON objects that are being migrated to their own tables.

// ---------------------------
// Units and Mercenaries
// ---------------------------
model UserUnit {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        UnitType // ENUM for 'CITIZEN', 'WORKER', etc.
  level       Int
  quantity    Int
  isMercenary Boolean  @default(false)
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, level, isMercenary])
  @@index([userId])
}

enum UnitType {
  CITIZEN
  WORKER
  OFFENSE
  DEFENSE
  SPY
  SENTRY
}

// Kingdom morale desertion ledger (#205). One row per unit row that left a
// kingdom on a given day; defectors also point at the player who received them.
enum DesertionEventKind {
  ABANDON
  DEFECT
  CITIZENS
  MERCENARY
}

model DesertionEvent {
  id              Int                @id @default(autoincrement())
  userId          Int
  eraId           Int?
  kind            DesertionEventKind
  unitType        UnitType
  unitLevel       Int
  quantity        Int
  defectedToUserId Int?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  user            users              @relation("DesertionEvents", fields: [userId], references: [id], onDelete: Cascade)
  defectedTo      users?             @relation("DesertionDefections", fields: [defectedToUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([defectedToUserId, createdAt])
}

// Dungeon captives (#210, #205 phase 4). One row per unit row taken captive
// in a battle; ransom, release, conversion and escape all consume whole rows.
model Captive {
  id         Int      @id @default(autoincrement())
  captorId   Int
  sourceId   Int
  unitType   UnitType
  unitLevel  Int
  quantity   Int
  capturedAt DateTime @db.Timestamptz(3)
  eraId      Int?
  captor     users    @relation("CaptivesHeld", fields: [captorId], references: [id], onDelete: Cascade)
  source     users    @relation("CaptivesLost", fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([captorId, eraId])
  @@index([sourceId, eraId])
  @@index([capturedAt])
}

// Captive ledger (#210): captures, ransoms, releases, conversions and escapes.
// Ransom/release/convert rows carry the caller's operationId for idempotency.
enum CaptiveEventKind {
  CAPTURED
  RANSOMED
  RELEASED
  CONVERTED
  ESCAPED
}

model CaptiveEvent {
  id           Int             @id @default(autoincrement())
  captorId     Int
  sourceId     Int?
  eraId        Int?
  kind         CaptiveEventKind
  unitType     UnitType
  unitLevel    Int
  quantity     Int
  gold         BigInt          @default(0)
  operationKey String?         @unique
  details      Json?
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  captor       users           @relation("CaptorCaptiveEvents", fields: [captorId], references: [id], onDelete: Cascade)
  source       users?          @relation("SourceCaptiveEvents", fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([captorId, createdAt])
  @@index([sourceId, createdAt])
}

// ---------------------------
// Items
// ---------------------------
model UserItem {
  id       Int       @id @default(autoincrement())
  userId   Int
  type     ItemType // ENUM for 'WEAPON', 'HELM', etc.
  level    Int
  usage    ItemUsage
  quantity Int
  user     users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, usage, level])
  @@index([userId])
}

enum ItemType {
  WEAPON
  HELM
  ARMOR
  BOOTS
  BRACERS
  SHIELD
}

enum ItemUsage {
  OFFENSE
  DEFENSE
  SPY
  SENTRY
}

// ---------------------------
// Upgrades
// ---------------------------
model UserStructureUpgrade {
  id     Int                  @id @default(autoincrement())
  userId Int
  type   StructureUpgradeType // ENUM for 'OFFENSE', 'ARMORY', etc.
  level  Int
  user   users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

enum StructureUpgradeType {
  OFFENSE
  SPY
  SENTRY
  ARMORY
}

model UserBattleUpgrade {
  id       Int               @id @default(autoincrement())
  userId   Int
  type     BattleUpgradeType // ENUM for 'OFFENSE', 'SPY', 'SENTRY', 'DEFENSE'
  level    Int
  quantity Int
  user     users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per owned level: combat (utils/combatStrength.ts) and the upgrades page read every level of a type
  @@unique([userId, type, level])
  @@index([userId])
}

enum BattleUpgradeType {
  OFFENSE
  SPY
  SENTRY
  DEFENSE
}

// ---------------------------
// Bonus Points
// ---------------------------
model UserBonusPoints {
  id     Int             @id @default(autoincrement())
  userId Int
  type   BonusPointsType // ENUM for 'OFFENSE', 'DEFENSE', etc.
  level  Int
  user   users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

enum BonusPointsType {
  OFFENSE
  DEFENSE
  INCOME
  INTEL
  PRICES
}

// ---------------------------
// Alliance System Extensions
// ---------------------------

model alliance_wars {
  id                   Int       @id @default(autoincrement())
  attacker_alliance_id Int
  defender_alliance_id Int? // Nullable if target is a user
  defender_user_id     Int? // Nullable if target is an alliance
  status               WarStatus @default(WARMUP)
  declared_by_user_id  Int
  start_at             DateTime  @db.Timestamptz(3)
  end_at               DateTime? @db.Timestamptz(3)
  created_at           DateTime  @default(now()) @db.Timestamptz(3)
  updated_at           DateTime  @updatedAt @db.Timestamptz(3)

  attacker_alliance alliances  @relation("AttackerAlliance", fields: [attacker_alliance_id], references: [id])
  defender_alliance alliances? @relation("DefenderAlliance", fields: [defender_alliance_id], references: [id])
  defender_user     users?     @relation("WarTargetUser", fields: [defender_user_id], references: [id])
  declared_by_user  users      @relation("DeclaredWars", fields: [declared_by_user_id], references: [id])

  targets war_targets[]

  @@index([attacker_alliance_id])
  @@index([defender_alliance_id])
  @@index([status])
}

model war_targets {
  id             Int      @id @default(autoincrement())
  war_id         Int
  target_user_id Int
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  war         alliance_wars @relation(fields: [war_id], references: [id], onDelete: Cascade)
  target_user users         @relation(fields: [target_user_id], references: [id], onDelete: Cascade)

  @@index([war_id])
  @@index([target_user_id])
}

model alliance_join_requests {
  id           Int      @id @default(autoincrement())
  alliance_id  Int
  user_id      Int
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  /// REQUEST: the player asked to join. INVITE: the alliance invited them.
  kind         String   @default("REQUEST")
  invited_by   Int?
  created_at   DateTime @default(now()) @db.Timestamptz(3)
  updated_at   DateTime @updatedAt @db.Timestamptz(3)
  moderated_by Int?

  alliance alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // One PENDING row per (alliance, user): partial unique index in SQL
  // (alliance_join_requests_one_pending), which Prisma cannot express.
  @@index([alliance_id])
  @@index([user_id])
}

model alliance_cooldowns {
  id          Int                  @id @default(autoincrement())
  user_id     Int
  alliance_id Int? // Optional if global cooldown, but typically per alliance for kicks?
  type        AllianceCooldownType
  expires_at  DateTime             @db.Timestamptz(3)
  created_at  DateTime             @default(now()) @db.Timestamptz(3)

  user     users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  alliance alliances? @relation(fields: [alliance_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([alliance_id])
}

model alliance_xp {
  alliance_id Int      @id
  xp          BigInt   @default(0)
  tier        Int      @default(1)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  alliance alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
}

model alliance_upgrades {
  id           Int      @id @default(autoincrement())
  alliance_id  Int
  upgrade_key  String
  tier         Int
  purchased_at DateTime @default(now()) @db.Timestamptz(3)

  alliance alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)

  @@index([alliance_id])
}

model alliance_bank_history {
  id                   Int                     @id @default(autoincrement())
  alliance_id          Int
  transaction_type     AllianceTransactionType
  amount               BigInt
  related_user_id      Int?
  performed_by_user_id Int
  notes                String?
  created_at           DateTime                @default(now()) @db.Timestamptz(3)

  alliance          alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  related_user      users?    @relation("RelatedUser", fields: [related_user_id], references: [id], onDelete: SetNull)
  performed_by_user users     @relation("PerformedBy", fields: [performed_by_user_id], references: [id], onDelete: Cascade)

  @@index([alliance_id])
  @@index([created_at])
}

/// Member requests for gold from the alliance treasury (#66 phase 2).
model alliance_gold_requests {
  id           Int                       @id @default(autoincrement())
  alliance_id  Int
  requester_id Int
  amount       BigInt
  reason       String?                   @db.VarChar(200)
  status       AllianceGoldRequestStatus @default(PENDING)
  decided_by   Int?
  decided_at   DateTime?                 @db.Timestamptz(3)
  created_at   DateTime                  @default(now()) @db.Timestamptz(3)

  alliance  alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  requester users     @relation("GoldRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  decider   users?    @relation("GoldRequestDecider", fields: [decided_by], references: [id], onDelete: SetNull)

  @@index([alliance_id, status])
  @@index([requester_id, status])
}

/// Treasury loans to members (#66 phase 3). interest_pct and amount_owed are fixed when the loan is requested (the quoted terms).
model alliance_loans {
  id                      Int                @id @default(autoincrement())
  alliance_id             Int
  borrower_id             Int
  principal               BigInt
  interest_pct            Int
  amount_owed             BigInt
  amount_repaid           BigInt             @default(0)
  pending_treasury_credit BigInt             @default(0)
  status                  AllianceLoanStatus @default(REQUESTED)
  reason                  String?            @db.VarChar(200)
  decided_by              Int?
  approved_at             DateTime?          @db.Timestamptz(3)
  due_at                  DateTime?          @db.Timestamptz(3)
  closed_at               DateTime?          @db.Timestamptz(3)
  created_at              DateTime           @default(now()) @db.Timestamptz(3)

  alliance alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)
  borrower users     @relation("LoanBorrower", fields: [borrower_id], references: [id], onDelete: Cascade)
  decider  users?    @relation("LoanDecider", fields: [decided_by], references: [id], onDelete: SetNull)

  @@index([alliance_id, status])
  @@index([borrower_id, status])
}

model alliance_fees {
  id              Int       @id @default(autoincrement())
  alliance_id     Int
  frequency       Frequency
  amount          BigInt
  exempt_role_ids Json?     @default("[]")
  next_run_at     DateTime? @db.Timestamptz(3)

  alliance alliances @relation(fields: [alliance_id], references: [id], onDelete: Cascade)

  @@index([alliance_id])
}

// ============================================================
// Staff Role & Moderation System
// ============================================================

model StaffRoleAssignment {
  id              Int       @id @default(autoincrement())
  userId          Int
  role            StaffRole
  grantedByUserId Int?
  note            String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  user      users  @relation("StaffRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy users? @relation("StaffRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([role, revokedAt])
}

model Report {
  id                Int               @id @default(autoincrement())
  reporterUserId    Int
  reportedUserId    Int
  category          ReportCategory
  priority          ReportPriority    @default(NORMAL)
  status            ReportStatus      @default(OPEN)
  subject           String?
  description       String
  roomId            Int?
  chatMessageId     Int?
  assignedToUserId  Int?
  resolution        ReportResolution?
  resolutionSummary String?
  resolvedByUserId  Int?
  resolvedAt        DateTime?         @db.Timestamptz(3)
  metadata          Json?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  reporter       users           @relation("ReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reportedUser   users           @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  assignedTo     users?          @relation("ReportsAssigned", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedBy     users?          @relation("ReportsResolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  room           ChatRoom?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  chatMessage    ChatMessage?    @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  actions        ReportAction[]
  banAppeals     BanAppeal[]
  moderatorNotes ModeratorNote[]

  @@index([status, priority, createdAt])
  @@index([assignedToUserId, status])
  @@index([reportedUserId, createdAt])
  @@index([reporterUserId, createdAt])
}

model ReportAction {
  id          Int              @id @default(autoincrement())
  reportId    Int
  actorUserId Int
  type        ReportActionType
  body        String?
  fromStatus  ReportStatus?
  toStatus    ReportStatus?
  metadata    Json?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
