  user      users  @relation("InactivityNoticeOnUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy users? @relation("InactivityNoticesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([scheduledDeletionAt])
}

model IdentityBlock {
