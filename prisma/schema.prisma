enum EmailCampaignKind {
  BROADCAST
  NEWS
  INACTIVITY_NOTICE
  INACTIVITY_REMINDER
}

enum EmailCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  CANCELLED
}

enum EmailCategory {
  ATTACK_NOTIFICATION
  TRANSACTIONAL
  NEWS
  ANNOUNCEMENT
  ACCOUNT_LIFECYCLE
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum EmailSuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
}

enum IdentityBlockKind {
  EMAIL
  DISPLAY_NAME
}

enum IdentityBlockReason {
  SANCTION
  DELETION_COOLDOWN
  RESERVED_NAME
}

model EmailPreference {
  userId                   Int       @id
  newsEmails               Boolean   @default(true)
  announcementEmails       Boolean   @default(true)
  attackNotificationEmails Boolean   @default(false)
  unsubscribedAllAt        DateTime? @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id              Int                 @id @default(autoincrement())
  kind            EmailCampaignKind
  subject         String
  body            String              @db.Text
  audience        Json
  status          EmailCampaignStatus @default(DRAFT)
  recipientCount  Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  skippedCount    Int                 @default(0)
  blogPostId      Int?
  createdByUserId Int?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?           @db.Timestamptz(3)

  createdBy users?        @relation("EmailCampaignsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  outbox    EmailOutbox[]

  @@unique([kind, blogPostId])
}

model EmailOutbox {
  eventKey      String?           @unique
  id            Int               @id @default(autoincrement())
  campaignId    Int?
  userId        Int?
  toAddress     String
  category      EmailCategory
  locale        String
  subject       String
  textBody      String            @db.Text
  htmlBody      String?           @db.Text
  headers       Json?
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?         @db.Timestamptz(3)
  sentAt        DateTime?         @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     users?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([status, nextAttemptAt])
}

model EmailSuppression {
  id              Int                    @id @default(autoincrement())
  hash            String                 @unique
  reason          EmailSuppressionReason
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
